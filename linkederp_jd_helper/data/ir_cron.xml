<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Triggered at once by the "Draft JD with AI" button; the hourly run only sweeps anything missed. -->
    <record id="ir_cron_draft_jd" model="ir.cron">
        <field name="name">HR Office: draft JDs with AI (VectorMind)</field>
        <field name="model_id" ref="model_linkederp_jd_helper"/>
        <field name="state">code</field>
        <field name="code">model._cron_draft_jds()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
