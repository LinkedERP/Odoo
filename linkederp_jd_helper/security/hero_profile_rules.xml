<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everyone sees their own profile and the ones they review; HR sees all. -->
    <record id="rule_hero_profile_own" model="ir.rule">
        <field name="name">Hero profile: own or to review</field>
        <field name="model_id" ref="model_linkederp_hero_profile"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('reviewer_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_hero_profile_hr" model="ir.rule">
        <field name="name">Hero profile: HR sees all</field>
        <field name="model_id" ref="model_linkederp_hero_profile"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <!-- ponytail: job and line rows follow no rule of their own; only reachable through a profile form. -->
</odoo>
