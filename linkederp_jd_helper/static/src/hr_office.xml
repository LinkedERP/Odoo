<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="linkederp_jd_helper.HrOffice">
        <div class="o_hr_office" t-att-class="{ 'o_hr_centered': area }">
            <div class="o_hr_office_head">
                <h1 t-esc="state.title"/>
                <span class="text-muted" t-esc="state.subtitle"/>
            </div>
            <div class="o_hr_tiles">
                <button type="button" class="o_hr_tile card" t-foreach="state.tiles" t-as="tile" t-key="tile.key"
                        t-att-class="{ 'o_hr_tile_soon': !tile.built }" t-on-click="() => this.open(tile)" t-att-title="tile.does">
                    <span class="o_hr_badge" t-if="tile.badge" t-esc="tile.badge"/>
                    <span class="o_hr_tile_icon"><i t-attf-class="fa {{ tile.icon }}"/></span>
                    <span class="o_hr_tile_name" t-esc="tile.name"/>
                    <span class="o_hr_tile_who text-muted" t-if="tile.manager" t-esc="tile.manager"/>
                    <span class="o_hr_tile_status" t-att-class="tile.hot ? 'text-danger' : (tile.built ? 'text-success' : 'text-muted')" t-esc="tile.status"/>
                </button>
            </div>
        </div>
    </t>
</templates>
