<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_hero" model="report.paperformat">
        <field name="name">Hero profile (A4, no margins)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="report_hero_profile" model="ir.actions.report">
        <field name="name">Hero Profile</field>
        <field name="model">linkederp.hero.profile</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">linkederp_jd_helper.hero_profile_page</field>
        <field name="report_file">linkederp_jd_helper.hero_profile_page</field>
        <field name="paperformat_id" ref="paperformat_hero"/>
        <field name="print_report_name">'Hero Profile - %s' % object.name</field>
    </record>

    <!-- One A4 page per consultant. Tables, not flex/grid: the PDF engine (wkhtmltopdf) is old. -->
    <template id="hero_profile_page">
        <t t-call="web.html_container">
            <t t-set="customer" t-value="(data or {}).get('customer') or ''"/>
            <t t-set="note" t-value="(data or {}).get('note') or ''"/>
            <t t-foreach="docs" t-as="doc">
                <t t-set="senior" t-value="doc.total_months &gt;= 36"/>
                <t t-set="skills" t-value="doc._page_skills()"/>
                <div class="page" style="position: relative; height: 1118px; overflow: hidden; page-break-after: always; font-family: Helvetica, Arial, 'DejaVu Sans', sans-serif; font-size: 12.5px; line-height: 1.5; color: #1b2233; background: #ffffff;">

                    <div style="background: #14254a; color: #ffffff; padding: 26px 38px 26px;">
                        <table style="width: 100%;"><tr>
                            <td style="font-weight: bold; font-size: 17px;">Linked<span style="color: #E8312F;">ERP</span></td>
                            <td style="text-align: right; font-size: 10px; letter-spacing: 2px; color: #aab6d3; font-weight: bold;">HERO PROFILE</td>
                        </tr></table>
                        <table style="width: 100%; margin-top: 16px;"><tr>
                            <td style="width: 140px; vertical-align: middle;">
                                <img t-if="doc.image" t-att-src="image_data_uri(doc.image)" style="width: 122px; height: 122px; border-radius: 61px; border: 3px solid #E8312F;" alt="Photo"/>
                            </td>
                            <td style="vertical-align: middle;">
                                <div style="font-size: 36px; font-weight: bold; line-height: 1.1;" t-out="doc.name"/>
                                <div style="font-size: 16px; color: #d7deef; margin-top: 4px;" t-out="doc.job_title or ''"/>
                                <div style="margin-top: 10px;">
                                    <t t-foreach="doc.platform_ids" t-as="pl">
                                        <span style="display: inline-block; font-size: 11.5px; font-weight: bold; background: #ffffff; color: #14254a; padding: 3px 11px; border-radius: 11px; margin-right: 6px;" t-out="pl.name"/>
                                    </t>
                                </div>
                            </td>
                        </tr></table>
                    </div>

                    <table style="width: 100%; background: #f3f5fa; border-bottom: 1px solid #e4e8f0;"><tr>
                        <t t-foreach="doc._page_facts()" t-as="fact">
                            <td style="width: 25%; padding: 14px 0 14px 38px; vertical-align: top;">
                                <div style="font-size: 9.5px; letter-spacing: 1.5px; color: #8a93a6; font-weight: bold;" t-out="fact[0].upper()"/>
                                <div t-attf-style="font-size: #{'22px' if fact_first else '15px'}; font-weight: bold; color: #{'#E8312F' if fact_first else '#14254a'}; line-height: 1.25;" t-out="fact[1]"/>
                                <div t-if="fact[2]" style="color: #5a6478; font-size: 11px;" t-out="fact[2]"/>
                            </td>
                        </t>
                    </tr></table>

                    <div t-if="note" style="margin: 20px 38px 0; background: #fdf1f0; padding: 10px 14px; border-radius: 8px;">
                        <b style="color: #E8312F;">Why this team: </b><span t-out="note"/>
                    </div>

                    <table style="width: 100%; margin-top: 22px;"><tr>
                        <td style="width: 55%; vertical-align: top; padding: 0 16px 0 38px;">
                            <div t-if="doc.headline" style="font-size: 17px; font-weight: bold; color: #14254a; line-height: 1.4;" t-out="doc.headline"/>
                            <div t-if="doc.summary" style="color: #3b4458; margin-top: 8px;" t-out="doc.summary"/>

                            <t t-if="doc.project_ids">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">SELECTED WORK</div>
                                <t t-foreach="doc.project_ids" t-as="pr">
                                    <div style="border: 1px solid #e4e8f0; border-radius: 9px; padding: 11px 14px; margin-top: 9px;">
                                        <table style="width: 100%;"><tr>
                                            <td style="font-weight: bold; font-size: 13px;"><t t-out="pr.name"/><t t-if="pr.year"> · <t t-out="pr.year"/></t></td>
                                            <td t-if="pr.platform_id" style="text-align: right;"><span style="font-size: 10px; color: #ffffff; background: #14254a; padding: 1px 8px; border-radius: 8px;" t-out="pr.platform_id.name"/></td>
                                        </tr></table>
                                        <div t-if="pr.part" style="color: #5a6478;">Their part: <t t-out="pr.part"/></div>
                                        <div t-if="pr.detail" style="color: #3b4458;" t-out="pr.detail"/>
                                    </div>
                                </t>
                            </t>

                            <t t-if="doc.proud_ids">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">PROUD OF</div>
                                <t t-foreach="doc.proud_ids" t-as="pd">
                                    <div style="margin-top: 6px;"><span style="color: #E8312F; font-weight: bold;">&#10003;</span>&#160; <t t-out="pd.name"/></div>
                                </t>
                            </t>

                            <t t-if="senior and doc.job_ids">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">CAREER</div>
                                <table style="width: 100%; margin-top: 6px;">
                                    <t t-foreach="doc.job_ids" t-as="job">
                                        <tr>
                                            <td style="width: 110px; color: #5a6478; vertical-align: top; padding: 3px 0;">
                                                <t t-out="job.date_from.year"/> to <t t-out="job.date_to.year if job.date_to else 'now'"/>
                                            </td>
                                            <td style="vertical-align: top; padding: 3px 0;"><b t-out="job.title"/>, <t t-out="job.company"/></td>
                                        </tr>
                                    </t>
                                </table>
                            </t>
                        </td>

                        <td style="width: 45%; vertical-align: top; padding: 0 38px 0 16px;">
                            <t t-if="doc.strength_ids">
                                <div style="font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">STRONGEST AT</div>
                                <t t-foreach="doc.strength_ids" t-as="st">
                                    <div style="background: #f3f5fa; border-radius: 8px; padding: 9px 12px; margin-top: 8px;">
                                        <div style="font-weight: bold; color: #14254a;" t-out="st.name"/>
                                        <div t-if="st.detail" style="color: #5a6478; font-size: 11.5px;" t-out="st.detail"/>
                                    </div>
                                </t>
                            </t>

                            <t t-if="skills">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">SKILLS</div>
                                <table style="width: 100%; margin-top: 4px;">
                                    <t t-foreach="skills" t-as="sk">
                                        <tr>
                                            <td style="padding: 3px 0;" t-out="sk.name"/>
                                            <td t-attf-style="text-align: right; padding: 3px 0; font-weight: bold; color: #{'#E8312F' if sk.level == 'expert' else '#14254a'};"
                                                t-out="'Expert' if sk.level == 'expert' else 'Proficient'"/>
                                        </tr>
                                    </t>
                                </table>
                            </t>

                            <t t-if="doc.certification_ids">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">CERTIFIED IN</div>
                                <t t-foreach="doc.certification_ids" t-as="ce">
                                    <div style="margin-top: 6px;"><b t-out="ce.name"/><t t-if="ce.year"> · <t t-out="ce.year"/></t></div>
                                </t>
                            </t>

                            <t t-if="doc.education_ids">
                                <div style="margin-top: 20px; font-size: 10.5px; letter-spacing: 2px; color: #E8312F; font-weight: bold;">EDUCATION</div>
                                <t t-foreach="doc.education_ids" t-as="ed">
                                    <div style="margin-top: 6px;"><b t-out="ed.name"/><t t-if="ed.detail">, <t t-out="ed.detail"/></t></div>
                                </t>
                            </t>
                        </td>
                    </tr></table>

                    <div t-if="not senior" style="margin: 22px 38px 0; background: #f3f5fa; border-radius: 12px; padding: 16px 18px;">
                        <div style="font-size: 15px; font-weight: bold; color: #14254a;">Your LinkedERP project team</div>
                        <table style="width: 100%; margin-top: 10px; border-collapse: separate; border-spacing: 8px 0;"><tr>
                            <td style="width: 33%; background: #ffffff; border-radius: 8px; padding: 10px 12px; vertical-align: top;"><b style="color: #14254a;">Solution architect</b><br/><span style="color: #5a6478; font-size: 11.5px;">Designs the solution and signs off key decisions</span></td>
                            <td style="width: 33%; background: #ffffff; border-radius: 8px; padding: 10px 12px; vertical-align: top;"><b style="color: #14254a;">Senior consultant</b><br/><span style="color: #5a6478; font-size: 11.5px;">Leads delivery and reviews all setup work</span></td>
                            <td style="width: 33%; background: #ffffff; border-radius: 8px; padding: 10px 12px; vertical-align: top; border: 2px solid #E8312F;"><b style="color: #E8312F;" t-out="doc.name.split(' ')[0]"/><br/><span style="color: #5a6478; font-size: 11.5px;">Day-to-day setup, data, testing and training</span></td>
                        </tr></table>
                    </div>

                    <table style="position: absolute; bottom: 0; left: 0; width: 100%; border-top: 1px solid #e4e8f0; font-size: 10px; color: #6b7487;"><tr>
                        <td style="padding: 10px 38px 16px;">Shared in confidence<t t-if="customer"> with <t t-out="customer"/></t> · approved <t t-out="doc.approved_on and doc.approved_on.strftime('%b %Y') or ''"/></td>
                        <td style="padding: 10px 38px 16px; text-align: right; font-weight: bold; color: #14254a;">www.linkederp.com</td>
                    </tr></table>
                </div>
            </t>
        </t>
    </template>
</odoo>
