<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_lwf" model="ir.ui.view">
        <field name="name">product.category.form.lot.warehouse.fifo</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form_stock"/>
        <field name="arch" type="xml">
            <field name="property_cost_method" position="after">
                <field name="lwf_per_warehouse" invisible="property_cost_method != 'fifo'"/>
            </field>
        </field>
    </record>
</odoo>
