<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_po_amendment" model="ir.sequence">
            <field name="name">Purchase Order Amendment</field>
            <field name="code">shubhada.po.amendment</field>
            <field name="prefix">AMD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="implementation">standard</field>
            <!-- shared across companies; without this it binds to whichever
                 company installed the module and next_by_code finds nothing -->
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
